*.pyc
checkpoints/
logs/
figures/
experiments/
_tmp*/
.codex_tmp/
*.pt
*.pth
*.pkl
*.pickle
*.npy
*.npz
*.csv
*.tsv
*.json
*.jsonl
*.xlsx
*.xls
*.pdf
*.docx
.env
.env.*
